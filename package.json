{
  "name": "vue3-vant-mobile",
  "type": "module",
  "version": "3.16.0",
  "packageManager": "pnpm@12.11.2",
  "description": "An mobile web apps template based on the Vue 3 ecosystem",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.0",
    "pnpm": ">=12.11.2"
  },
  "scripts": {
    "dev": "cross-env MOCK_SERVER_PORT=8086 vite",
    "build:dev": "vue-tsc --noEmit && vite build --mode development",
    "build:pro": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp --commit --push --tag",
    "typecheck": "vue-tsc --noEmit",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@unhead/vue": "3.4.2",
    "@vant/touch-emulator": "^1.5.0",
    "@vant/use": "^1.6.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "resize-detector": "^0.3.0",
    "vant": "^4.10.2",
    "vconsole": "^3.15.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@iconify-json/carbon": "^1.2.28",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@unocss/eslint-config": "66.10.5",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.6.1",
    "bumpp": "^12.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "mockjs": "^1.1.0",
    "postcss-mobile-forever": "^5.0.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "unocss": "66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-mock-dev-server": "^2.4.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-vconsole": "^2.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint $1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
